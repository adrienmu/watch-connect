<?xml version="1.0" encoding="utf-8"?>
<!--
    Aucune sauvegarde dans le cloud : les données de santé ne partent jamais vers Google Drive.
    Seul le transfert local d'un téléphone à l'autre (câble ou Wi-Fi direct, à la configuration
    du nouvel appareil) copie la base et les réglages.

    Rien de secret n'est copié en clair : les réglages ne contiennent jamais la phrase de passe des
    sauvegardes chiffrées, seulement la clé qui en est dérivée, chiffrée par une clé du Keystore Android
    qui, elle, ne voyage pas. Sur le nouveau téléphone, cette clé est donc illisible : l'app demande de
    ressaisir la phrase de passe et la sauvegarde automatique échoue proprement en attendant.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="boucle.db" />
        <include domain="database" path="boucle.db-wal" />
        <include domain="database" path="boucle.db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
